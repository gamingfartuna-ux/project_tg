# VideoVeoBot — configuration
# Copy this file to .env and fill in the values

# Telegram bot token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Comma-separated Telegram user IDs of admins (optional)
ADMIN_IDS=

# SQLite database path (absolute path recommended for Windows)
DATABASE_URL=sqlite+aiosqlite:///./veo_video_bot.db

# ---------------------------------------------------------------------------
# Mini App URL (Telegram requires HTTPS for web_app buttons)
# ---------------------------------------------------------------------------
# Local dev: http://127.0.0.1:8080/
# Production (Railway): https://your-app.up.railway.app
TWA_URL=https://resourceful-learning-production-fb76.up.railway.app

# ---------------------------------------------------------------------------
# TWA API server (aiohttp — serves both UI and /api/*)
# ---------------------------------------------------------------------------
# Railway injects PORT; set TWA_API_HOST to 0.0.0.0 on Railway
TWA_API_HOST=127.0.0.1
TWA_API_PORT=8080
# PORT is injected automatically by Railway; it takes precedence over TWA_API_PORT

# TTL for Telegram initData (seconds) — 0 to disable freshness check
TWA_INIT_DATA_TTL=3600

# Allowed origins for CORS (comma-separated, optional)
TWA_ALLOWED_ORIGINS=
